<Page x:Class="WpfUP_GM.Pages.Regestaration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfUP_GM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Regestaration">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Регистрация" FontSize="24" HorizontalAlignment="Center"></TextBlock>
            <StackPanel Grid.Row="1" Grid.RowSpan="7">
                <TextBlock HorizontalAlignment="Left" Text="E-mail" FontSize="16"/>
                <TextBox x:Name="Email" MinHeight="40"/>
                <TextBlock HorizontalAlignment="Left" Text="Логин" FontSize="16"/>
                <TextBox Name="login" MinHeight="40"/>
                <TextBlock  HorizontalAlignment="Left" Text="Имя"  FontSize="16"/>
                <TextBox Name="name" MinHeight="40"/>
                <TextBlock  HorizontalAlignment="Left" Text="Пароль"  FontSize="16"/>
                <PasswordBox  Name="password" MinHeight="40"/>
                <Button Height="40" Content="Зарегистрироваться" Click="Button_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
