<Page x:Class="WpfUP_GM.Pages.MyAccount"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfUP_GM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MyAccount">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Grid.Row="1" Text="login" Margin="5"></TextBlock>
        <TextBlock Grid.Column="1" Grid.Row="2" Text="password" Margin="5"></TextBlock>
        <TextBlock Grid.Column="1" Grid.Row="3" Text="e-mail" Margin="5"></TextBlock>
        <TextBlock Grid.Column="1" Grid.Row="4" Text="Name" Margin="5"></TextBlock>
        <TextBlock Grid.Column="1" Grid.Row="5" Text="IsActive" Margin="5"></TextBlock>
        <TextBlock Grid.Column="2" Grid.Row="5" Text="Role" Margin="5"></TextBlock>
        <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding login}" IsReadOnly="True" Margin="5"></TextBox>
        <TextBox Grid.Column="2" Grid.Row="2" Text="{Binding password}" Margin="5"></TextBox>
        <TextBox Grid.Column="2" Grid.Row="3" Text="{Binding email}" Margin="5"></TextBox>
        <TextBox Grid.Column="2" Grid.Row="4" Text="{Binding Name}" Margin="5"></TextBox>
        <TextBox Grid.Column="2" Grid.Row="5" Text="{Binding IsActive}" IsReadOnly="True" Margin="5"></TextBox>
        <TextBox Grid.Column="2" Grid.Row="5" Text="{Binding Role.Name}" IsReadOnly="True" Margin="5"></TextBox>
        <Button Grid.Column="2" Grid.Row="6" Margin="5" Content="Получить роль-автор" Click="Button_Click"> </Button>
    </Grid>
</Page>
