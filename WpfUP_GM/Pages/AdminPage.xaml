<Page x:Class="WpfUP_GM.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfUP_GM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Name="ListOfReport" Content="Список жалоб" Click="ListOfReport_Click"></Button>
        <Button Name="Frezze" Grid.Column="1" Content="Заморозки" Click="Frezze_Click"></Button>
        <Button Name="BidAuthor" Grid.Column="2"  Content="Заявка на роль автора" Click="BidAuthor_Click"></Button>
        <ComboBox Grid.Column="3" x:Name="TypeListComboBox"  IsEditable="True">
            <ComboBoxItem Content="Список пользователей" Selected="ComboBoxItem_Selected"> </ComboBoxItem>
            <ComboBoxItem Content="Список книг" Selected="ComboBoxItem_Selected_1"></ComboBoxItem>
            <ComboBoxItem Content="Список отзывов" Selected="ComboBoxItem_Selected_2"></ComboBoxItem>
        </ComboBox>
        <Frame x:Name="AdminFrame" Grid.Row="1" Grid.ColumnSpan="5" Grid.RowSpan="8"></Frame>
    </Grid>
</Page>
