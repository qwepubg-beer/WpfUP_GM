<Page x:Class="WpfUP_GM.Pages.AccInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfUP_GM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccInfoPage">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
            <Button Name="MyAccount" Margin="5" Content="Мой аккаунт" Grid.Column="1" Click="MyAccount_Click"></Button>
            <Button Name="Rewiews" Margin="5" Content="Мои отзывы" Grid.Column="2" Click="Rewiews_Click"></Button>
            <Button Name="Freeze" Margin="5" Content="Ваш аккаунт заморожен" Grid.Column="3" Visibility="Hidden" Click="Freeze_Click"></Button>
            <Frame NavigationUIVisibility="Hidden" Name="UserFrame" Grid.Row="1" Grid.RowSpan="8" Grid.ColumnSpan="5" Margin="5"/>
            <ComboBox x:Name="TypeListComboBox" Margin="5" Grid.Column="0" IsEditable="True" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="TypeListComboBox_SelectionChanged">
        </ComboBox>
    </Grid>
</Page>
