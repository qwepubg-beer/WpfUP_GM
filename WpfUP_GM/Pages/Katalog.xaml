<Page x:Class="WpfUP_GM.Pages.Katalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfUP_GM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Katalog">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="ProductList"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="4" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center">
                        <Image Height="120" Width="90"  Source="{Binding Cover}" Margin="0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding User.Name, StringFormat=Автор: {0}}"/>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}"/>
                            <Button Height="40" Content="Информация" Click="Button_Click_2" Name="TargetButton"></Button>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <ComboBox x:Name="GenreComboBox" Grid.Column="3" IsEditable="True" DisplayMemberPath="GenreName" SelectedValuePath="Id" SelectionChanged="GenreComboBox_SelectionChanged"></ComboBox>
        <ComboBox x:Name="TypeComboBox" Grid.Column="2" IsEditable="True" SelectionChanged="TypeComboBox_SelectionChanged">
            <ComboBoxItem Content="По рейтингу возрастание"></ComboBoxItem>
            <ComboBoxItem Content="По рейтингу убывание"></ComboBoxItem>
            <ComboBoxItem Content="По имени"></ComboBoxItem>
        </ComboBox>
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Поиск" Click="Button_Click_1" Grid.Column="0"/>
            <Button Content="Сброс" Click="Button_Click" Grid.Column="1"/>
        </Grid>
        <TextBox Name="TextSearch" TextWrapping="Wrap" Text="" Grid.Column="0" Margin="8"/>
    </Grid>
</Page>
