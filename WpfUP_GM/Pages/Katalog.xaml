<Page x:Class="WpfUP_GM.Pages.Katalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfUP_GM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Katalog">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="ProductList"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="4" Grid.Row="1">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Image Height="120" Width="90"  Source="{Binding Cover}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Padding="5" Text="{Binding User.Name, StringFormat=Автор: {0}}"/>
                            <TextBlock Padding="5" Text="{Binding Name}" TextWrapping="Wrap"/>
                            <TextBlock Padding="5" Text="{Binding Rating, StringFormat=Рейтинг: {0}}"/>
                            <Button Height="40" Content="Информация" Click="Button_Click_2"></Button>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" >
            <ComboBox x:Name="GenreComboBox" Width="180" Grid.Column="1" Height="40" IsEditable="True" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="5" SelectionChanged="GenreComboBox_SelectionChanged"></ComboBox>
            <ComboBox x:Name="TypeComboBox" Width="180" Grid.Column="2" Height="40"  DisplayMemberPath="Name" SelectedValuePath="Id" IsEditable="True" Margin="5" SelectionChanged="TypeComboBox_SelectionChanged">
            <ComboBoxItem Content="По рейтингу возрастание"></ComboBoxItem>
            <ComboBoxItem Content="По рейтингу убывание"></ComboBoxItem>
            <ComboBoxItem Content="По имени"></ComboBoxItem>
        </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Поиск" HorizontalAlignment="Center" VerticalAlignment="Center" Width="80" Height="30" MaxWidth="200" MaxHeight="60" Click="Button_Click_1"/>
            <Button Content="Сброс" HorizontalAlignment="Center" VerticalAlignment="Center" Width="80" Height="30" MaxWidth="200" MaxHeight="60" Margin="10,0,0,0" Click="Button_Click" />
        </StackPanel>
        <TextBox Name="TextSearch" HorizontalAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Center"  Width="180" Height="30" MaxWidth="400" MaxHeight="60"/>
    </Grid>
</Page>
