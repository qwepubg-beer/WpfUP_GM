<Page x:Class="WpfUP_GM.Pages.BookInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfUP_GM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookInfo">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ReportAuthor" Content="Жалоба на автора" Click="ReportAuthor_Click" Grid.Column="0"/>
            <Button x:Name="FrezzeAuthor" Content="Заморозить автора" Grid.Column="0" Visibility="Hidden"/>
            <Button x:Name="ReadButton" Content="Читать" Click="Button_Click_2"  Grid.Column="1"/>
        </Grid>
        <Grid Grid.Column="2" Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Name="ReportRew"  Content="Пожаловаться" Click="Button_Click" Grid.Column="0"/>
            <Button Name="AdminFrezeRewiew" Content="Пожаловаться" Click="AdminFrezeRewiew_Click" Grid.Column="0" Visibility="Hidden"/>
            <Button  Content="Добавить" Click="Button_Click_1" Grid.Column="1"/>
        </Grid>
        <Image Grid.RowSpan="3" Source="{Binding Cover}"/>
        <TextBlock Name="Autor" Grid.Row="1" Text="{Binding User.Name, StringFormat=Автор: {0}}" Grid.Column="1"/>
        <TextBlock Name="BookName" Grid.Row="0" Text="{Binding Name}" TextWrapping="Wrap"  Grid.Column="1"/>
        <TextBlock Grid.Row="2" Text="{Binding Rating, StringFormat=Рейтинг: {0}}" Grid.Column="1"/>
        <TextBlock Grid.Row="3" Grid.RowSpan="2" Text="{Binding Description, StringFormat=Описание: {0}}" Grid.ColumnSpan="2"/>
        <Button Grid.Row="6" Content="Добавить книгу в список" Click="Button_Click_3" Grid.ColumnSpan="2"/>
        <ListBox x:Name="RewiewList"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Column="2" Grid.Row="0" Grid.RowSpan="7" >
        <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding User.Name, StringFormat=Пользователь: {0}}"/>
                        <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
