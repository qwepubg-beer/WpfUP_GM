<Page x:Class="WpfUP_GM.Pages.BookInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfUP_GM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookInfo">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Grid.Row="8" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ReportAuthor" Content="Жалоба на автора" Click="ReportAuthor_Click" Grid.Column="0" Margin="5"/>
            <Button x:Name="AutorButton" Content="Изменить" Click="Button_Click_2"  Grid.Column="1" Margin="5" Visibility="Hidden"/>
        </Grid>
        <Grid Grid.Column="1" Grid.Row="8" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button  Content="Пожаловаться" Click="Button_Click" Grid.Column="0" Margin="5"/>
            <Button  Content="Добавить" Click="Button_Click_1" Grid.Column="1" Margin="5"/>
        </Grid> 
        <Image Grid.RowSpan="3" Source="{Binding Cover}" Margin="5"/>
        <TextBox Name="Autor" Grid.Row="3"  Text="{Binding User.Name, StringFormat=Автор: {0}}" IsReadOnly="True" Margin="5"/>
        <TextBox Name="BookName" Grid.Row="4"  Text="{Binding Name}" TextWrapping="Wrap" IsReadOnly="True" Margin="5"/>
        <TextBox Grid.Row="5"  Text="{Binding Rating, StringFormat=Рейтинг: {0}}" IsReadOnly="True" Margin="5"/>
        <Button Grid.Row="5"  Content="Добавить книгу в список" Click="Button_Click_3" Margin="5"/>
        <ListBox x:Name="RewiewList"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Column="1" Grid.Row="0" Grid.RowSpan="7">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Padding="5" Text="{Binding User.Name, StringFormat=Пользователь: {0}%}"/>
                        <TextBlock Padding="5" Text="{Binding Rating, StringFormat=Рейтинг: {0}}"/>
                        <TextBlock Padding="5" Text="{Binding Text}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
