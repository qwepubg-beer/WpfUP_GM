<Page x:Class="WpfUP_GM.Pages.ListOfBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfUP_GM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListOfBook">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        <Button Name="Save" Click="Save_Click" Content="Сохранить"></Button>
        <ListBox x:Name="ProductList"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         d:ItemsSource="{d:SampleData ItemCount=5}"
         SelectionChanged="ProductList_SelectionChanged" Grid.Row="1" Grid.ColumnSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center">
                        <Image Height="100" Width="160" Source="{Binding Cover}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Book.User.Name, StringFormat=Автор: {0}}"/>
                            <TextBlock Text="{Binding Book.Name}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Name="Read" Height="40" Content="Читать" Click="Read_Click"/>
                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=TypeBookList}" DisplayMemberPath="TypeName" SelectedValuePath="Id" SelectedValue="{Binding TypeListID, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="TypeComboBox_SelectionChanged"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
