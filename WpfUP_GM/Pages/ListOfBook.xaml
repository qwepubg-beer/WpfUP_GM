<Page x:Class="WpfUP_GM.Pages.ListOfBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfUP_GM.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListOfBook">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Name="Save" Click="Save_Click" Content="Сохранить" Margin="5" Padding="10,5"/>

        <ListBox x:Name="ProductList"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 d:ItemsSource="{d:SampleData ItemCount=5}"
                 Grid.Row="1" Grid.ColumnSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center">
                        <Image Height="100" Width="160" Source="{Binding Book.Cover}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Book.User.Name, StringFormat='Автор: {0}'}"/>
                            <TextBlock Text="{Binding Book.Name}"/>
                        </StackPanel>
                        <Button Name="Read" Height="30" Content="Читать" Click="Read_Click" Margin="0,2"/>
                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=AvailableTypes}" 
                                  DisplayMemberPath="TypeName" 
                                  SelectedValuePath="id" 
                                  SelectedValue="{Binding TypeListID, UpdateSourceTrigger=PropertyChanged}" 
                                  SelectionChanged="TypeComboBox_SelectionChanged"
                                  Margin="0,2"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
