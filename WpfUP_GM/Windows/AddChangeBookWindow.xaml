<Window x:Class="WpfUP_GM.Windows.AddChangeBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUP_GM.Windows"
        mc:Ignorable="d"
        Title="AddChangeBookWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название" VerticalAlignment="Center" Margin="5" />
        <TextBox Name="BookName" Grid.Row="0" Grid.Column="1" Margin="5" TextWrapping="Wrap" Text="{Binding Book.Name}" Height="30"></TextBox>
        <TextBlock Name="RatingText" Text="Содержимое" Grid.Row="1" Grid.Column="0"  VerticalAlignment="Center" Margin="5" TextWrapping="Wrap"/>
        <TextBox Name="BookText" Grid.Row="1" Grid.Column="1" Margin="5" TextWrapping="Wrap" Text="{Binding Book.Text}" Height="80"></TextBox>
        <TextBlock Text="Обложка" Grid.Row="2" Grid.Column="0"  VerticalAlignment="Center" Margin="5" TextWrapping="Wrap"/>
        <TextBox Name="BookCover" Grid.Row="2" Grid.Column="2" Margin="5" TextWrapping="Wrap" Text="{Binding Book.Cover}" Height="30"></TextBox>
        <StackPanel Grid.Row="3" Grid.RowSpan="2" Margin="5" VerticalAlignment="Center">
            <ComboBox x:Name="GenreComboBox" Width="160" Height="40" IsEditable="True" DisplayMemberPath="GenreName" SelectedValuePath="Id" Margin="5" SelectedIndex="0"></ComboBox>
            <Button Name="AddGenre" Height="Auto" Content="Добавить" Click="AddGenre_Click"></Button>
        </StackPanel>
        <ListBox x:Name="GenresList"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Column="1" Grid.Row="3" Grid.RowSpan="2">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding GenreName, StringFormat= Жанр: {0}}"/>
                            <Button Name="DeleteGenre" Height="30" Content="Удалить" Click="DeleteGenre_Click"></Button>
                        </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Сохранить" Width="80" Margin="5" Click="ConfirmButton_Click"/>
            <Button Content="Отмена" Width="80" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
