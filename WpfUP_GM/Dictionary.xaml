<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ListBox x:Key="ListBoxStyle" Margin="5" Padding="5"/>
    <Button x:Key="ButtonStyle" Margin="5" Height="auto" Width="auto" FontSize="14"/>
    <ComboBox x:Key="ComboboxStyle" Margin="5" Height="auto" Width="auto" FontSize="14"></ComboBox>
    <TextBlock x:Key="TextBlockStyle" FontSize="14" TextWrapping="Wrap"></TextBlock>
    <TextBox x:Key="TextBoxStyle" FontSize="14" TextWrapping="Wrap"></TextBox>
    <PasswordBox x:Key="PasswordBoxStyle" FontSize="14"></PasswordBox>
    <Grid x:Key="GridinGridStyle" Margin="5"></Grid>
    <Slider x:Key="SliderStyle"/>
    <Image x:Key="ImageStyle"/>
</ResourceDictionary>